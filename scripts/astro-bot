#!/bin/bash

PROJ_DIR="$HOME/Projects/astro-assistant"
PID_FILE="/tmp/astro-bot.pid"
LOG_FILE="/tmp/astro-bot.log"

start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "Bot вже запущено (PID $(cat $PID_FILE))"
        return
    fi
    cd "$PROJ_DIR"
    nohup /usr/bin/python3 bot.py >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "Bot запущено (PID $!)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID"
            rm -f "$PID_FILE"
            echo "Bot зупинено (PID $PID)"
        else
            rm -f "$PID_FILE"
            echo "Bot не запущено"
        fi
    else
        echo "Bot не запущено"
    fi
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
        echo "✅ Bot запущено (PID $(cat $PID_FILE))"
    else
        echo "❌ Bot не запущено"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    log)     tail -f "$LOG_FILE" ;;
    *)
        echo "Використання: astro-bot {start|stop|restart|status|log}"
        ;;
esac
